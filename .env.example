# Public Supabase credentials (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL used for auth redirects and unsubscribe links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional legacy provider for local/dev only (campaigns require connected Gmail)
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Mhenbulk <noreply@example.com>"

# Google OAuth (Gmail sending) — never put these in NEXT_PUBLIC_*
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 32-byte key, base64 — encrypt OAuth tokens at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ACCOUNT_ENCRYPTION_KEY=

# Queue tuning
EMAIL_QUEUE_BATCH_SIZE=5
EMAIL_QUEUE_CONCURRENCY=1
EMAIL_SEND_DELAY_MS=800
MAX_RETRIES=3

# Email Finder (public website crawl limits)
EMAIL_FINDER_MAX_SCANS_PER_HOUR=20
EMAIL_FINDER_MAX_PAGES_PER_SCAN=15
EMAIL_FINDER_MAX_PAGES_PER_DOMAIN=15
EMAIL_FINDER_REQUEST_TIMEOUT=12000
EMAIL_FINDER_TIMEOUT_MS=12000
EMAIL_FINDER_MAX_RESPONSE_SIZE=1500000
EMAIL_FINDER_MAX_RESPONSE_BYTES=1500000
EMAIL_FINDER_PAGE_CONCURRENCY=3
EMAIL_FINDER_URL_CONCURRENCY=5
# Optional Playwright fallback (requires a local Playwright install)
EMAIL_FINDER_BROWSER_FALLBACK=0
EMAIL_FINDER_DEBUG=0

# Email Finder bulk website lists (background queue)
EMAIL_FINDER_BATCH_PAGES_PER_SITE=12
EMAIL_FINDER_BATCH_MAX_DEPTH=2
EMAIL_FINDER_BATCH_SITE_BUDGET_MS=28000
EMAIL_FINDER_BATCH_SITE_CONCURRENCY=5
EMAIL_FINDER_BATCH_PAGE_CONCURRENCY=3
EMAIL_FINDER_BATCH_TARGETS_PER_RUN=40
EMAIL_FINDER_BATCH_MAX_ATTEMPTS=3
EMAIL_FINDER_BATCH_RETRY_BACKOFF_MS=1500

# Required dedicated secret for signing unsubscribe tokens (32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=

# Required by /api/cron/process-email-queue.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-secret

# Signing secret from the Resend webhook settings (starts with whsec_).
# Required for delivery tracking at /api/webhooks/resend (Resend only).
# RESEND_WEBHOOK_SECRET=
